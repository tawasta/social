<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.mass.mailing.recipient.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mass_mailing.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="///setting[@name='mass_mailing_reports_setting_container']"
                position="after"
            >
                <setting help="Don't allow a single mailing to have more recipients">
                    <field name="mass_mailing_recipient_limit" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
