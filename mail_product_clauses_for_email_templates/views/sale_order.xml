<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field
            name="name"
        >sale.order.view.form.mail.product.clauses.for.email.templates</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <notebook position="inside">
                <page string="E-mail Product Clauses">

                        <div class="text-muted mb-4">
                            If the Sale Order e-mail template is configured to include
                            product clauses, the following clauses will be appended to the e-mail:
                        </div>

                        <field name="email_product_clause_contents" nolabel="1" />

                        <button
                        name="mail_product_clauses_for_email_templates.email_product_clauses_action"
                        icon="fa-arrow-right"
                        type="action"
                        string="Manage E-Mail Product Clauses"
                        class="btn-primary oe_right mt-4"
                    />
                </page>
            </notebook>
        </field>
    </record>
</odoo>
