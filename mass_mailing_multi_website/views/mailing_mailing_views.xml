<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mass_mailing_form" model="ir.ui.view">
        <field name="name">mailing.mailing.multi.company.form</field>
        <field name="model">mailing.mailing</field>
        <field
            name="inherit_id"
            ref="mass_mailing.mailing_mailing_view_form_full_width"
        />
