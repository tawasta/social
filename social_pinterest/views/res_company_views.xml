<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_inherit_social_pinterest" model="ir.ui.view">
        <field name="name">res.company.form.inherit.social.pinterest</field>
        <field name="model">res.company</field>
        <field
            name="inherit_id"
            ref="social_media.view_company_form_inherit_social_media"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='social_tiktok']" position="after">
                <field name="social_pinterest" />
            </xpath>
        </field>
    </record>
</odoo>
