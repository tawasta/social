<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//a[@t-out='company.website']" position="after">
                <t
                t-if="company.company_registry and (company.phone or company.email or company.website)"
            > |</t>
                <a t-if="company.company_registry" t-out="company.company_registry" />

        </xpath>

    </template>

    <template id="mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[@t-out='company.website']" position="after">
                <t
                t-if="company.company_registry and (company.phone or company.email or company.website)"
            > |</t>
                <a t-if="company.company_registry" t-out="company.company_registry" />

        </xpath>

    </template>

</odoo>
