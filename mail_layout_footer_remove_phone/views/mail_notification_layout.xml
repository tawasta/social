<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//t[@t-out='company.phone']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- hide also the following | separator -->
        <xpath
            expr="//t[@t-if='company.email and company.phone']"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template id="mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//t[@t-out='company.phone']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- hide also the following | separator -->
        <xpath
            expr="//t[@t-if='company.email and company.phone']"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
