<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.recursive.attachment.search</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">

                <div id="recursive_attachment_search">
                    <block title="Recursive attachment search" name="recursive-search">
                        <setting
                            id="recursive_search"
                            help="Set Recursive BoM search for e-mail attachments to selected models"
                        >
                            <field
                                name="recursive_attachment_model_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_open': True}"
                            />
                        </setting>

                        <setting
                            id="recursive_search_level"
                            help="Set Recursive BoM search level for e-mail attachments"
                        >
                            <field name="recursive_level" />
                        </setting>

                        <setting
                            id="recursive_search_size_limit"
                            help="Set size limit for e-mail attachments which are searched recursively from BoM"
                        >
                            <field name="attachment_size_limit" />
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
